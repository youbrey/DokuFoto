<UserControl x:Class="SetwanDokuFoto.UI.Controls.PhotoFrameControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ClipToBounds="False"
             Focusable="True"
             PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
             PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
             PreviewMouseMove="OnPreviewMouseMove"
             PreviewMouseWheel="OnPreviewMouseWheel"
             SizeChanged="OnSizeChanged">
    <Grid x:Name="Root" ClipToBounds="False">
        <!-- First render pass: low-opacity full photo outside the fixed frame. -->
        <Canvas x:Name="OutsideCanvas"
                ClipToBounds="False"
                IsHitTestVisible="False"
                Opacity=".32"
                Visibility="Collapsed">
            <Image x:Name="OutsidePhoto" RenderTransformOrigin=".5,.5" />
        </Canvas>

        <!-- Second render pass: identical transform clipped by the frame. -->
        <Border x:Name="FrameBorder"
                Background="#F1F5F9"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="3"
                ClipToBounds="True">
            <Grid>
                <Canvas x:Name="InsideCanvas" ClipToBounds="True">
                    <Image x:Name="InsidePhoto" RenderTransformOrigin=".5,.5" />
                </Canvas>

                <Border x:Name="Placeholder"
                        Background="#F8FAFC"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        Cursor="Hand">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="21" Background="#E0F2FE" Margin="0,0,0,8">
                            <TextBlock Text="＋" Foreground="#0284C7" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Tambahkan foto" Foreground="#334155" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Klik atau seret foto ke frame" Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Grid x:Name="CropOverlay" Visibility="Collapsed" IsHitTestVisible="False">
                    <Rectangle Stroke="#FFFFFF" StrokeThickness="1" StrokeDashArray="4,3" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" BorderBrush="#AAFFFFFF" BorderThickness="0,0,1,1" />
                        <Border Grid.Row="0" Grid.Column="1" BorderBrush="#AAFFFFFF" BorderThickness="0,0,1,1" />
                        <Border Grid.Row="1" Grid.Column="0" BorderBrush="#AAFFFFFF" BorderThickness="0,0,1,1" />
                        <Border Grid.Row="1" Grid.Column="1" BorderBrush="#AAFFFFFF" BorderThickness="0,0,1,1" />
                    </Grid>
                    <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
                            Background="#DC0F172A" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="10" Padding="9,4">
                        <TextBlock Text="MODE CROP • tarik foto • scroll untuk zoom" Foreground="#FDE68A" FontWeight="Bold" FontSize="9" />
                    </Border>
                </Grid>

                <Border x:Name="CaptionChrome" VerticalAlignment="Bottom" Background="#DDF8FAFC" Padding="7,5">
                    <TextBlock Text="{Binding Caption}" Foreground="#1E293B" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>
        </Border>

        <Border x:Name="SelectionBorder"
                BorderBrush="#0EA5E9"
                BorderThickness="2"
                CornerRadius="4"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="#0EA5E9" BlurRadius="8" Opacity=".45" ShadowDepth="0" />
            </Border.Effect>
        </Border>
    </Grid>
</UserControl>

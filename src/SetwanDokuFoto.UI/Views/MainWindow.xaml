<Window x:Class="SetwanDokuFoto.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SetwanDokuFoto.UI.ViewModels"
        mc:Ignorable="d"
        Title="Setwan DokuFoto - Sekretariat DPRD Kota Bitung" 
        Height="850" Width="1350"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation Bar -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SETWAN DOKUFOTO" Foreground="#38BDF8" FontWeight="Bold" FontSize="16" Margin="0,0,10,0"/>
                    <TextBlock Text="• Sekretariat DPRD Kota Bitung" Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Ekspor Dokumen .docx" Command="{Binding ExportDocxCommand}" Margin="4" Padding="12,6" Background="#0284C7" Foreground="White" FontWeight="Bold"/>
                    <Button Content="Pratinjau &amp; Cetak" Command="{Binding PrintDocumentCommand}" Margin="4" Padding="12,6" Background="#059669" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Workspace (Sidebar + Canvas) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar (Template, Media, Text, Kop Surat, Margins) -->
            <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,1,0" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="PILIHAN TEMPLATE KISI" Foreground="#F8FAFC" FontWeight="Bold" Margin="0,0,0,8"/>
                        <ListBox Height="200" Background="#0F172A" BorderBrush="#334155" Foreground="White" SelectedIndex="0">
                            <ListBoxItem Content="Kisi 2x2 (4 Foto Standar Setwan)"/>
                            <ListBoxItem Content="Kisi 1 Foto Utama Penuh"/>
                            <ListBoxItem Content="Kisi 2 Foto (Kiri &amp; Kanan)"/>
                            <ListBoxItem Content="Kisi 6 Foto (2 Kolom x 3 Baris)"/>
                        </ListBox>

                        <TextBlock Text="UKURAN KERTAS &amp; MARGIN" Foreground="#F8FAFC" FontWeight="Bold" Margin="0,16,0,8"/>
                        <ComboBox SelectedIndex="0" Background="#0F172A" Foreground="Black">
                            <ComboBoxItem Content="F4 / Folio (215 x 330 mm) - Baku Setwan"/>
                            <ComboBoxItem Content="A4 (210 x 297 mm)"/>
                            <ComboBoxItem Content="Letter (215.9 x 279.4 mm)"/>
                            <ComboBoxItem Content="Legal (215.9 x 355.6 mm)"/>
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Center WYSIWYG Document Canvas -->
            <ScrollViewer Grid.Column="1" Background="#020617" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Border Background="White" Width="794" MinHeight="1123" Margin="30" Padding="40" CornerRadius="2">
                    <StackPanel>
                        <!-- Official Kop Surat -->
                        <Border BorderBrush="Black" BorderThickness="0,0,0,2" Padding="0,0,0,8" Margin="0,0,0,16">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="PEMERINTAH KOTA BITUNG" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock Text="DEWAN PERWAKILAN RAKYAT DAERAH" FontWeight="Black" FontSize="16" HorizontalAlignment="Center"/>
                                <TextBlock Text="SEKRETARIAT DEWAN" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock Text="Jl. Sam Ratulangi No. 45, Kel. Bitung Barat Satu, Kec. Maesa, Kota Bitung" FontSize="11" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Title and Meta -->
                        <TextBlock Text="DOKUMENTASI FOTO KEGIATAN PERSIDANGAN" FontWeight="Black" FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Masa Persidangan Ketiga Tahun Sidang 2025/2026" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                        <!-- Photo Grid 2x2 -->
                        <UniformGrid Rows="2" Columns="2" Margin="0,10">
                            <Border BorderBrush="#CBD5E1" BorderThickness="1" Height="220" Margin="4" Background="#F1F5F9">
                                <TextBlock Text="[ Slot Foto 1 - Drag &amp; Drop Foto ]" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#64748B" FontSize="12"/>
                            </Border>
                            <Border BorderBrush="#CBD5E1" BorderThickness="1" Height="220" Margin="4" Background="#F1F5F9">
                                <TextBlock Text="[ Slot Foto 2 - Drag &amp; Drop Foto ]" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#64748B" FontSize="12"/>
                            </Border>
                            <Border BorderBrush="#CBD5E1" BorderThickness="1" Height="220" Margin="4" Background="#F1F5F9">
                                <TextBlock Text="[ Slot Foto 3 - Drag &amp; Drop Foto ]" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#64748B" FontSize="12"/>
                            </Border>
                            <Border BorderBrush="#CBD5E1" BorderThickness="1" Height="220" Margin="4" Background="#F1F5F9">
                                <TextBlock Text="[ Slot Foto 4 - Drag &amp; Drop Foto ]" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#64748B" FontSize="12"/>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#0F172A" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
